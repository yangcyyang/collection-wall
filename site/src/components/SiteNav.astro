---
import { HIDE_SIDEHUSTLE_FOR_DEMO } from "../lib/sidehustle.mjs";

type Props = { current: "wall" | "news" | "twitter" | "knowledge" | "zsxq" | "prompts" | "skills" | "thinking" | "nvpusa" | "radar" | "xianyu" | "xiaohongshu" | "sidehustle" | "producthunt" | "linuxdo" | "login" };
const { current } = Astro.props;
const items = [
  { id: "wall", href: "/", label: "收藏墙" },
  { id: "news", href: "/news/", label: "资讯" },
  { id: "twitter", href: "/twitter/", label: "推特日报" },
  { id: "knowledge", href: "/knowledge/", label: "知识总结" },
  { id: "zsxq", href: "/zsxq/", label: "知识星球" },
  { id: "prompts", href: "/prompts/", label: "提示词" },
  { id: "skills", href: "/skills/", label: "技能" },
  { id: "thinking", href: "/thinking/", label: "思维方法" },
  { id: "nvpusa", href: "/nvpusa/", label: "nvpusa" },
  { id: "radar", href: "/radar/", label: "雷达" },
  { id: "xianyu", href: "/xianyu/", label: "闲鱼" },
  { id: "xiaohongshu", href: "/xiaohongshu/", label: "小红书" },
  { id: "sidehustle", href: "/sidehustle/", label: "副业" },
  { id: "producthunt", href: "/producthunt/", label: "Product Hunt" },
  { id: "linuxdo", href: "/linuxdo/", label: "linux.do" },
].filter((item) => !HIDE_SIDEHUSTLE_FOR_DEMO || item.id !== "sidehustle");
---

<nav class="tabs" aria-label="站点栏目">
  {items.map((item) => (
    <a
      class:list={["tab", { "is-active": current === item.id }]}
      href={current === "wall" && item.id === "wall" ? "#collection-wall" : item.href}
      aria-current={current === item.id ? "page" : undefined}
    >{item.label}</a>
  ))}
</nav>
