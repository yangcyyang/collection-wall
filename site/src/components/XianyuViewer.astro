---
import { formatBeijingDateTime } from "../lib/news.mjs";
import {
  xianyuConfidenceLabel,
  xianyuKindLabel,
  xianyuStatusClass,
  xianyuStatusLabel,
} from "../lib/xianyu";

const { items = [] } = Astro.props;
---

<div class="radar-viewer" hidden data-xianyu-viewer>
  <button type="button" class="radar-viewer-backdrop" data-xianyu-close aria-label="关闭详情" tabindex="-1"></button>
  <div class="radar-viewer-dialog" role="dialog" aria-modal="true" aria-labelledby="xianyu-viewer-title">
    <button type="button" class="radar-viewer-close" data-xianyu-close>关闭</button>
    <div class="radar-viewer-body" data-xianyu-body></div>
  </div>
</div>

{items.map((item) => {
  const tags = item.tags ?? [];
  return (
    <template data-xianyu-template={item.id}>
      <header class="radar-viewer-header">
        <div>
          <h2 id="xianyu-viewer-title">{item.title}</h2>
          <p class="radar-viewer-summary">{item.summary}</p>
        </div>
        <div class="radar-viewer-meta">
          {item.kind && <span class="category">{xianyuKindLabel(item.kind)}</span>}
          {item.confidence && <span class="category">{xianyuConfidenceLabel(item.confidence)}</span>}
          <span class:list={["status", xianyuStatusClass(item.status)]}>{xianyuStatusLabel(item.status)}</span>
        </div>
      </header>
      {tags.length > 0 && <div class="tag-list">{tags.map((tag) => <span>{tag}</span>)}</div>}
      {item.why_it_matters && (
        <section class="radar-viewer-section">
          <h3>为何值得关注</h3>
          <p>{item.why_it_matters}</p>
        </section>
      )}
      {(item.price || item.category) && (
        <section class="radar-viewer-section">
          <h3>类目与价格</h3>
          <p>{[item.category, item.price].filter(Boolean).join(" · ")}</p>
        </section>
      )}
      {(item.first_detected || item.last_updated) && (
        <section class="radar-viewer-section">
          <h3>时间</h3>
          <p>
            {item.first_detected ? `首次发现 ${formatBeijingDateTime(item.first_detected)}` : ""}
            {item.first_detected && item.last_updated ? " · " : ""}
            {item.last_updated ? `最近更新 ${formatBeijingDateTime(item.last_updated)}` : ""}
          </p>
        </section>
      )}
      {item.url && (
        <section class="radar-viewer-section">
          <h3>闲鱼链接</h3>
          <p class="news-links">
            <a class="tweet-link" href={item.url} target="_blank" rel="noreferrer">{item.url} →</a>
          </p>
        </section>
      )}
    </template>
  );
})}

<script>
  const viewer = document.querySelector("[data-xianyu-viewer]");
  const body = viewer?.querySelector("[data-xianyu-body]");
  const dialog = viewer?.querySelector(".radar-viewer-dialog");
  const closeBtn = viewer?.querySelector(".radar-viewer-close");
  let lastTrigger = null;

  function setBackgroundInert(on) {
    if (!viewer) return;
    for (const child of document.body.children) {
      if (child === viewer || child.tagName === "SCRIPT") continue;
      child.toggleAttribute("inert", on);
    }
  }

  function trapFocusables() {
    if (!dialog) return [];
    return [closeBtn, ...dialog.querySelectorAll("a[href], button")].filter((el, index, list) => {
      return el && !el.hidden && list.indexOf(el) === index;
    });
  }

  function open(key, trigger) {
    const template = document.querySelector(`[data-xianyu-template="${CSS.escape(key)}"]`);
    if (!template || !viewer || !body) return;
    lastTrigger = trigger ?? null;
    body.replaceChildren(template.content.cloneNode(true));
    viewer.hidden = false;
    document.body.classList.add("radar-viewer-open");
    setBackgroundInert(true);
    closeBtn?.focus();
  }

  function close() {
    if (!viewer || viewer.hidden) return;
    viewer.hidden = true;
    document.body.classList.remove("radar-viewer-open");
    setBackgroundInert(false);
    body?.replaceChildren();
    lastTrigger?.focus();
    lastTrigger = null;
  }

  document.querySelectorAll("[data-xianyu-open]").forEach((button) => {
    button.addEventListener("click", () => {
      open(button.getAttribute("data-xianyu-key") ?? "", button);
    });
  });

  viewer?.querySelectorAll("[data-xianyu-close]").forEach((button) => {
    button.addEventListener("click", close);
  });

  document.addEventListener("keydown", (event) => {
    if (!viewer || viewer.hidden) return;
    if (event.key === "Escape") {
      close();
      return;
    }
    if (event.key !== "Tab") return;
    const list = trapFocusables();
    if (!list.length) return;
    const first = list[0];
    const last = list[list.length - 1];
    const outside = !list.includes(document.activeElement);
    if (list.length === 1 || outside || (event.shiftKey && document.activeElement === first) || (!event.shiftKey && document.activeElement === last)) {
      event.preventDefault();
      (event.shiftKey ? last : first).focus();
    }
  });
</script>
