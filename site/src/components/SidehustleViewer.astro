---
import { formatBeijingDateTime } from "../lib/news.mjs";
import {
  SECTION_LABELS,
  sidehustleIndexLabel,
  sidehustleLevelClass,
  sidehustleLevelLabel,
  sidehustleModelClass,
  sidehustleModelLabel,
  sidehustleSignalClass,
  sidehustleSignalLabel,
} from "../lib/sidehustle";

const { items = [] } = Astro.props;
---

<div class="radar-viewer" hidden data-side-viewer>
  <button type="button" class="radar-viewer-backdrop" data-side-close aria-label="关闭详情" tabindex="-1"></button>
  <div class="radar-viewer-dialog" role="dialog" aria-modal="true" aria-labelledby="side-viewer-title">
    <button type="button" class="radar-viewer-close" data-side-close>关闭</button>
    <div class="radar-viewer-body" data-side-body></div>
  </div>
</div>

{items.map((item) => {
  const tags = item.tags ?? [];
  const evidence = item.evidence ?? [];
  const sectionLabel = SECTION_LABELS[item.section] ?? item.section ?? "";
  const indexLabel = sidehustleIndexLabel(item.index);
  const levels = [
    item.start_cost && `起步成本 ${sidehustleLevelLabel(item.start_cost)}`,
    item.delivery && `交付难度 ${sidehustleLevelLabel(item.delivery)}`,
    item.competition && `竞争 ${sidehustleLevelLabel(item.competition)}`,
  ].filter(Boolean);
  return (
    <template data-side-template={item.key}>
      <header class="radar-viewer-header">
        <div>
          <h2 id="side-viewer-title">{item.title}</h2>
          <p class="radar-viewer-summary">{item.summary}</p>
        </div>
        <div class="radar-viewer-meta">
          {sectionLabel && <span class="category">{sectionLabel}</span>}
          {item.signal_strength && (
            <span class:list={["status", sidehustleSignalClass(item.signal_strength)]}>
              {sidehustleSignalLabel(item.signal_strength)}
            </span>
          )}
          {item.model && (
            <span class:list={["status", sidehustleModelClass(item.model)]}>
              {sidehustleModelLabel(item.model)}
            </span>
          )}
          {indexLabel && <span class="category">{indexLabel}</span>}
        </div>
      </header>
      {tags.length > 0 && <div class="tag-list">{tags.map((tag) => <span>{tag}</span>)}</div>}
      {item.why && (
        <section class="radar-viewer-section">
          <h3>为何值得关注</h3>
          <p>{item.why}</p>
        </section>
      )}
      {item.audience && (
        <section class="radar-viewer-section">
          <h3>目标人群</h3>
          <p>{item.audience}</p>
        </section>
      )}
      {item.result && (
        <section class="radar-viewer-section">
          <h3>交付结果</h3>
          <p>{item.result}</p>
        </section>
      )}
      {item.offer && (
        <section class="radar-viewer-section">
          <h3>卖点</h3>
          <p>{item.offer}</p>
        </section>
      )}
      {item.ai_help && (
        <section class="radar-viewer-section">
          <h3>AI 如何提效</h3>
          <p>{item.ai_help}</p>
        </section>
      )}
      {levels.length > 0 && (
        <section class="radar-viewer-section">
          <h3>起步成本 / 交付难度 / 竞争</h3>
          <p>{levels.join(" · ")}</p>
          <div class="radar-viewer-meta">
            {item.start_cost && (
              <span class:list={["status", sidehustleLevelClass(item.start_cost)]}>
                {sidehustleLevelLabel(item.start_cost)}
              </span>
            )}
            {item.delivery && (
              <span class:list={["status", sidehustleLevelClass(item.delivery)]}>
                {sidehustleLevelLabel(item.delivery)}
              </span>
            )}
            {item.competition && (
              <span class:list={["status", sidehustleLevelClass(item.competition)]}>
                {sidehustleLevelLabel(item.competition)}
              </span>
            )}
          </div>
        </section>
      )}
      {(item.first_detected || item.last_updated) && (
        <section class="radar-viewer-section">
          <h3>时间</h3>
          <p>
            {item.first_detected ? `首次发现 ${formatBeijingDateTime(item.first_detected)}` : ""}
            {item.first_detected && item.last_updated ? " · " : ""}
            {item.last_updated ? `最近更新 ${formatBeijingDateTime(item.last_updated)}` : ""}
          </p>
        </section>
      )}
      {evidence.length > 0 && (
        <section class="radar-viewer-section">
          <h3>证据</h3>
          <ul class="radar-evidence">
            {evidence.map((entry) => (
              <li>
                {entry.title && <span class="tweet-author">{entry.title}</span>}
                {entry.note && <p>{entry.note}</p>}
                {entry.url && (
                  <a class="tweet-link" href={entry.url} target="_blank" rel="noreferrer">{entry.url} →</a>
                )}
              </li>
            ))}
          </ul>
        </section>
      )}
    </template>
  );
})}

<script>
  const viewer = document.querySelector("[data-side-viewer]");
  const body = viewer?.querySelector("[data-side-body]");
  const dialog = viewer?.querySelector(".radar-viewer-dialog");
  const closeBtn = viewer?.querySelector(".radar-viewer-close");
  let lastTrigger = null;

  function setBackgroundInert(on) {
    if (!viewer) return;
    for (const child of document.body.children) {
      if (child === viewer || child.tagName === "SCRIPT") continue;
      child.toggleAttribute("inert", on);
    }
  }

  function trapFocusables() {
    if (!dialog) return [];
    return [closeBtn, ...dialog.querySelectorAll("a[href], button")].filter((el, index, list) => {
      return el && !el.hidden && list.indexOf(el) === index;
    });
  }

  function open(key, trigger) {
    const template = document.querySelector(`[data-side-template="${CSS.escape(key)}"]`);
    if (!template || !viewer || !body) return;
    lastTrigger = trigger ?? null;
    body.replaceChildren(template.content.cloneNode(true));
    viewer.hidden = false;
    document.body.classList.add("radar-viewer-open");
    setBackgroundInert(true);
    closeBtn?.focus();
  }

  function close() {
    if (!viewer || viewer.hidden) return;
    viewer.hidden = true;
    document.body.classList.remove("radar-viewer-open");
    setBackgroundInert(false);
    body?.replaceChildren();
    lastTrigger?.focus();
    lastTrigger = null;
  }

  document.querySelectorAll("[data-side-open]").forEach((button) => {
    button.addEventListener("click", () => {
      open(button.getAttribute("data-side-key") ?? "", button);
    });
  });

  viewer?.querySelectorAll("[data-side-close]").forEach((button) => {
    button.addEventListener("click", close);
  });

  document.addEventListener("keydown", (event) => {
    if (!viewer || viewer.hidden) return;
    if (event.key === "Escape") {
      close();
      return;
    }
    if (event.key !== "Tab") return;
    const list = trapFocusables();
    if (!list.length) return;
    const first = list[0];
    const last = list[list.length - 1];
    const outside = !list.includes(document.activeElement);
    if (list.length === 1 || outside || (event.shiftKey && document.activeElement === first) || (!event.shiftKey && document.activeElement === last)) {
      event.preventDefault();
      (event.shiftKey ? last : first).focus();
    }
  });
</script>
