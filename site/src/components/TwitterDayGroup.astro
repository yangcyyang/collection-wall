---
import { formatDayLabel, formatTime, avatarUrl, isShortTweet, categoryOf, type TwitterDay, type TagCategories } from "../lib/twitter";

type Props = { day: TwitterDay; defaultOpen?: boolean; categories?: TagCategories };
const { day, defaultOpen = false, categories } = Astro.props;
const [dateLabel, weekdayLabel] = formatDayLabel(day.date).split(" ");
---

<details class="day-group" data-day open={defaultOpen}>
  <summary class="day-heading">
    <span class="day-toggle-icon" aria-hidden="true">▾</span>
    <h2>{dateLabel}</h2>
    <p>{weekdayLabel} · {day.items.length} 条</p>
  </summary>
  <div class="timeline-items">
    {day.items.map((item) => (
      <article class="timeline-item" data-tweet data-tags={(item.tags ?? []).join(",")} data-categories={categories ? [...new Set((item.tags ?? []).map((t) => categoryOf(t, categories)))].join(",") : ""} data-tweet-url={item.url} role="link" tabindex="0">
        <span class="timeline-time">{formatTime(item.created_at)}</span>
        <span class="timeline-rail"><i class="timeline-dot"></i></span>
        <div class="tweet-card">
          <img class="tweet-avatar" src={avatarUrl(item.author)} alt="" loading="lazy" />
          <div class="tweet-body">
            <div class="tweet-meta">
              <span class="tweet-author">@{item.author}</span>
              {Number.isFinite(item.score) && <span class="tweet-score">热度{Math.round(item.score)}</span>}
              <a class="tweet-link" href={item.url} target="_blank" rel="noreferrer">跳转原推 →</a>
            </div>
            {isShortTweet(item) ? (
              <p class="tweet-summary tweet-fulltext">{item.summary}</p>
            ) : (
              <>
                <h3 class="tweet-title">{item.title}</h3>
                <p class="tweet-summary">{item.summary}</p>
              </>
            )}
            <div class="tag-list">{(item.tags ?? []).map((tag) => <span>{tag}</span>)}</div>
            <p class="tweet-reason">推荐理由：{item.recommend_reason}</p>
          </div>
        </div>
      </article>
    ))}
  </div>
</details>
