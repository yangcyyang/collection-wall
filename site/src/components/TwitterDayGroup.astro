---
import { formatDayLabel, formatTime, avatarUrl, isShortTweet, type TwitterDay } from "../lib/twitter";

type Props = { day: TwitterDay };
const { day } = Astro.props;
---

<div class="day-group" data-day>
  <div class="day-heading">
    <h2>{formatDayLabel(day.date)}</h2>
    <p>{day.items.length} 条</p>
  </div>
  <div class="tweet-list">
    {day.items.map((item) => (
      <article class="tweet-card" data-tweet data-tags={(item.tags ?? []).join(",")}>
        <img class="tweet-avatar" src={avatarUrl(item.author)} alt="" loading="lazy" />
        <div class="tweet-body">
          <div class="tweet-meta">
            <span class="tweet-time">{formatTime(item.created_at)}</span>
            <span class="tweet-author">@{item.author}</span>
            <span class="tweet-score">热度{Math.round(item.score)}</span>
            <a class="tweet-link" href={item.url} target="_blank" rel="noreferrer">跳转原推 →</a>
          </div>
          {isShortTweet(item) ? (
            <p class="tweet-summary tweet-original">{item.text}</p>
          ) : (
            <>
              <h3 class="tweet-title">{item.title}</h3>
              <p class="tweet-summary">{item.summary}</p>
            </>
          )}
          <div class="tag-list">{(item.tags ?? []).map((tag) => <span>{tag}</span>)}</div>
          <p class="tweet-reason">推荐理由：{item.recommend_reason}</p>
        </div>
      </article>
    ))}
  </div>
</div>
