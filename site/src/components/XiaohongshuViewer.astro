---
import { formatBeijingDateTime } from "../lib/news.mjs";
import {
  SECTION_LABELS,
  xiaohongshuDirectionClass,
  xiaohongshuDirectionLabel,
  xiaohongshuSignalClass,
  xiaohongshuSignalLabel,
} from "../lib/xiaohongshu";

const { items = [] } = Astro.props;
---

<div class="radar-viewer" hidden data-xhs-viewer>
  <button type="button" class="radar-viewer-backdrop" data-xhs-close aria-label="关闭详情" tabindex="-1"></button>
  <div class="radar-viewer-dialog" role="dialog" aria-modal="true" aria-labelledby="xhs-viewer-title">
    <button type="button" class="radar-viewer-close" data-xhs-close>关闭</button>
    <div class="radar-viewer-body" data-xhs-body></div>
  </div>
</div>

{items.map((item) => {
  const tags = item.tags ?? [];
  const evidence = item.evidence ?? [];
  const sectionLabel = SECTION_LABELS[item.section] ?? item.section ?? "";
  return (
    <template data-xhs-template={item.key}>
      <header class="radar-viewer-header">
        <div>
          <h2 id="xhs-viewer-title">{item.title}</h2>
          <p class="radar-viewer-summary">{item.summary}</p>
        </div>
        <div class="radar-viewer-meta">
          {sectionLabel && <span class="category">{sectionLabel}</span>}
          {item.signal_strength && (
            <span class:list={["status", xiaohongshuSignalClass(item.signal_strength)]}>
              {xiaohongshuSignalLabel(item.signal_strength)}
            </span>
          )}
          {item.direction && (
            <span class:list={["status", xiaohongshuDirectionClass(item.direction)]}>
              {xiaohongshuDirectionLabel(item.direction)}
            </span>
          )}
        </div>
      </header>
      {tags.length > 0 && <div class="tag-list">{tags.map((tag) => <span>{tag}</span>)}</div>}
      {item.why && (
        <section class="radar-viewer-section">
          <h3>为何值得关注</h3>
          <p>{item.why}</p>
        </section>
      )}
      {(item.audience || item.price) && (
        <section class="radar-viewer-section">
          <h3>人群与价格</h3>
          <p>{[item.audience, item.price].filter(Boolean).join(" · ")}</p>
        </section>
      )}
      {(item.first_detected || item.last_updated) && (
        <section class="radar-viewer-section">
          <h3>时间</h3>
          <p>
            {item.first_detected ? `首次发现 ${formatBeijingDateTime(item.first_detected)}` : ""}
            {item.first_detected && item.last_updated ? " · " : ""}
            {item.last_updated ? `最近更新 ${formatBeijingDateTime(item.last_updated)}` : ""}
          </p>
        </section>
      )}
      {evidence.length > 0 && (
        <section class="radar-viewer-section">
          <h3>证据</h3>
          <ul class="radar-evidence">
            {evidence.map((entry) => (
              <li>
                {entry.title && <span class="tweet-author">{entry.title}</span>}
                {entry.note && <p>{entry.note}</p>}
                {entry.url && (
                  <a class="tweet-link" href={entry.url} target="_blank" rel="noreferrer">{entry.url} →</a>
                )}
              </li>
            ))}
          </ul>
        </section>
      )}
    </template>
  );
})}

<script>
  const viewer = document.querySelector("[data-xhs-viewer]");
  const body = viewer?.querySelector("[data-xhs-body]");
  const dialog = viewer?.querySelector(".radar-viewer-dialog");
  const closeBtn = viewer?.querySelector(".radar-viewer-close");
  let lastTrigger = null;

  function setBackgroundInert(on) {
    if (!viewer) return;
    for (const child of document.body.children) {
      if (child === viewer || child.tagName === "SCRIPT") continue;
      child.toggleAttribute("inert", on);
    }
  }

  function trapFocusables() {
    if (!dialog) return [];
    return [closeBtn, ...dialog.querySelectorAll("a[href], button")].filter((el, index, list) => {
      return el && !el.hidden && list.indexOf(el) === index;
    });
  }

  function open(key, trigger) {
    const template = document.querySelector(`[data-xhs-template="${CSS.escape(key)}"]`);
    if (!template || !viewer || !body) return;
    lastTrigger = trigger ?? null;
    body.replaceChildren(template.content.cloneNode(true));
    viewer.hidden = false;
    document.body.classList.add("radar-viewer-open");
    setBackgroundInert(true);
    closeBtn?.focus();
  }

  function close() {
    if (!viewer || viewer.hidden) return;
    viewer.hidden = true;
    document.body.classList.remove("radar-viewer-open");
    setBackgroundInert(false);
    body?.replaceChildren();
    lastTrigger?.focus();
    lastTrigger = null;
  }

  document.querySelectorAll("[data-xhs-open]").forEach((button) => {
    button.addEventListener("click", () => {
      open(button.getAttribute("data-xhs-key") ?? "", button);
    });
  });

  viewer?.querySelectorAll("[data-xhs-close]").forEach((button) => {
    button.addEventListener("click", close);
  });

  document.addEventListener("keydown", (event) => {
    if (!viewer || viewer.hidden) return;
    if (event.key === "Escape") {
      close();
      return;
    }
    if (event.key !== "Tab") return;
    const list = trapFocusables();
    if (!list.length) return;
    const first = list[0];
    const last = list[list.length - 1];
    const outside = !list.includes(document.activeElement);
    if (list.length === 1 || outside || (event.shiftKey && document.activeElement === first) || (!event.shiftKey && document.activeElement === last)) {
      event.preventDefault();
      (event.shiftKey ? last : first).focus();
    }
  });
</script>
