---
import "../styles/global.css";
import LogoutControl from "../components/LogoutControl.astro";
import SiteNav from "../components/SiteNav.astro";
import { getTools } from "../lib/tools";
import { selectFeaturedTools } from "../lib/tool-order.mjs";
import { categoryCounts } from "../lib/tool-filter.mjs";
import { compactAskCatalog } from "../lib/ask-ai-gemini.mjs";
import { countAddedOnShanghaiDate, toolSearchBlob } from "../lib/shanghai-date.mjs";

const tools = await getTools();
const categories = categoryCounts(tools);
const todayAddedCount = countAddedOnShanghaiDate(tools);
const intentChips = [
  { label: "PPT", keywords: "ppt 演示" },
  { label: "提示词", keywords: "提示词 prompt" },
  { label: "API", keywords: "api" },
  { label: "视频", keywords: "视频 video" },
];
const askExamples = [
  { label: "PPT", query: "做一份给客户看的 PPT" },
  { label: "提示词", query: "找好用的提示词工具" },
  { label: "API 代理", query: "需要一个 API 代理或中转" },
  { label: "AI 视频", query: "用 AI 生成或剪辑视频" },
];
const askCatalog = compactAskCatalog(tools);
const askCatalogJson = JSON.stringify(askCatalog).replaceAll("<", "\\u003c");
const frequentTools = selectFeaturedTools(
  tools.filter((tool) => ["⭐ 高频", "📦 常用"].includes(tool.status ?? "")),
);
const recentTools = tools.filter((tool) => !frequentTools.includes(tool));
const hasFrequentSection = frequentTools.length >= 3;
const visibleTools = hasFrequentSection ? recentTools : tools;

function statusClass(status?: string) {
  if (status?.includes("高频")) return "frequent";
  if (status?.includes("常用")) return "common";
  if (status?.includes("偶尔")) return "occasional";
  return "new";
}

function categoryIcon(category?: string) {
  return category?.split(" ")[0] ?? "🧭";
}
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="cy 的工具收藏墙" />
    <title>收藏墙 · 工具库</title>
  </head>
  <body>
    <a class="skip-link" href="#collection-wall">跳到列表</a>
    <div class="page-shell">
      <header class="site-header">
        <div>
          <p class="eyebrow">个人工具库</p>
          <h1>收藏墙</h1>
          <p class="intro">把常用工具留在看得见的地方，随时回顾、随手打开。</p>
        </div>
        <div class="header-stats">
          <p class="record-count">{tools.length} 条已收录</p>
          {todayAddedCount > 0 && <p class="today-badge">今日 +{todayAddedCount}</p>}
          <LogoutControl />
        </div>
      </header>

      <SiteNav current="wall" />

      {tools.length === 0 ? (
        <main id="collection-wall">
        <section class="empty-state" aria-labelledby="empty-title">
          <p class="empty-icon">✦</p>
          <h2 id="empty-title">还没有收藏</h2>
          <p>在 Chrome 收藏一个网站，等待同步后它会出现在这里。</p>
          <button type="button" data-sync-notice>查看同步说明</button>
        </section>
        </main>
      ) : (
        <>
          <section class="wall-layout" aria-label="收藏筛选与卡片区">
            <aside class="category-sidebar" aria-label="按分类筛选">
              <div class="sidebar-heading">
                <p class="eyebrow">分类浏览</p>
                <span>{categories.length} 类</span>
              </div>
              <div class="category-list">
                <button class="category-button is-selected" type="button" data-category-filter="" title="全部工具" aria-pressed="true">
                  <span>全部工具</span><em>{tools.length}</em>
                </button>
                {categories.map(({ category, count }) => <button class="category-button" type="button" data-category-filter={category} title={category} aria-pressed="false">
                  <span>{category}</span><em>{count}</em>
                </button>)}
              </div>
            </aside>

            <div class="wall-content">
              <section class="ask-ai-panel" aria-label="问 AI">
                <div class="ask-ai-heading">
                  <div>
                    <p class="eyebrow">三层检索 · 免费</p>
                    <label class="ask-ai-label" for="ask-ai-query">你在做什么？</label>
                  </div>
                  <button type="button" class="ask-settings" data-ask-settings aria-label="Ask AI 设置">设置</button>
                </div>
                <textarea id="ask-ai-query" data-ask-query rows="2" placeholder="例如：做一份给客户看的 PPT"></textarea>
                <div class="ask-ai-actions">
                  <button type="button" class="ask-submit" data-ask-submit>Ask AI</button>
                  <p class="ask-status" data-ask-status></p>
                </div>
                <div class="ask-examples" aria-label="示例">
                  {askExamples.map((chip) => (
                    <button class="intent-chip" type="button" data-ask-example={chip.query}>{chip.label}</button>
                  ))}
                </div>
              </section>
              <dialog class="ask-settings-dialog" data-ask-settings-dialog>
                <p class="eyebrow">三层检索 · 免费</p>
                <h2>Ask AI 设置</h2>
                <p>先本地语义，不够再走 Gemini；额度用完会改关键词搜索。自备密钥只存在这台浏览器的 localStorage，除了向 Gemini 发请求外不会上传。</p>
                <label>
                  <span>你自己的 Gemini API Key（可选）</span>
                  <input type="password" data-gemini-key autocomplete="off" placeholder="AIza…" />
                </label>
                <p class="ask-settings-actions">
                  <button type="button" class="ask-submit" data-ask-settings-save>保存</button>
                  <button type="button" class="empty-action" data-ask-settings-close>关闭</button>
                </p>
              </dialog>
              <div class="search-row">
                <label class="search-box">
                  <span class="search-icon" aria-hidden="true">⌕</span>
                  <input
                    type="search"
                    data-tool-search
                    aria-label="搜索名称、标签或能力，按 / 聚焦"
                    placeholder="例如 design-dna 或 PPT"
                    autocomplete="off"
                  />
                </label>
                <p><strong data-match-count>{tools.length}</strong> 条匹配 · 含任一关键词</p>
              </div>
              <div class="intent-row" aria-label="按在做什么筛选">
                <p class="eyebrow">在做什么</p>
                <div class="intent-chips">
                  {intentChips.map((chip) => (
                    <button class="intent-chip" type="button" data-intent-filter={chip.keywords} aria-pressed="false">{chip.label}</button>
                  ))}
                </div>
              </div>
              <div class="filter-empty" data-filter-empty hidden>
                <p data-filter-empty-message>没有找到匹配的工具，换个词或分类试试。</p>
                <p class="filter-empty-actions">
                  <button type="button" class="empty-action" data-clear-search>清除搜索</button>
                  <button type="button" class="empty-action" data-clear-filters>查看全部工具</button>
                </p>
              </div>

          <main id="collection-wall">
          {hasFrequentSection && (
            <section class="tool-section" data-section="frequent" aria-labelledby="frequent-title">
              <div class="section-heading">
                <div>
                  <p class="eyebrow">快速回到高频工具</p>
                  <h2 id="frequent-title">常用精华</h2>
                </div>
                <p>{frequentTools.length} 条高频 / 常用</p>
              </div>
              <div class="tool-grid">
                {frequentTools.map((tool) => <article class:list={["tool-card", { "is-failed": tool.capture_status === "failed" }]} data-tool data-tool-id={tool.id} data-category={tool.category} data-search={toolSearchBlob(tool)}>
                  <a class="card-link" href={tool.url} target="_blank" rel="noreferrer" aria-label={tool.name}></a>
                  <div class="cover-wrap">
                    {tool.cover ? <img src={`/${tool.cover}`} alt="" loading="lazy" /> : <div class="cover-fallback" aria-hidden="true">{categoryIcon(tool.category)}</div>}
                  </div>
                  <div class="card-content">
                    <div class="card-meta"><span class="category">{tool.category}</span><span class:list={["status", statusClass(tool.status)]}>{tool.status}</span></div>
                    <h3>{tool.name}</h3>
                    <p title={tool.headline || "尚待补充用途说明"}>{tool.headline || "尚待补充用途说明"}</p>
                    <p class="ask-reason" data-ask-reason hidden></p>
                    <div class="tag-list">{(tool.tags ?? []).slice(0, 8).map((tag) => <span>{tag}</span>)}</div>
                  </div>
                </article>)}
              </div>
            </section>
          )}

          <section class="tool-section" data-section="recent" aria-labelledby="recent-title">
            <div class="section-heading">
              <div>
                <p class="eyebrow">按最近加入排序</p>
                <h2 id="recent-title">{hasFrequentSection ? "最近收藏" : "全部收藏"}</h2>
              </div>
              <p>{visibleTools.length} 条</p>
            </div>
            <div class="tool-grid">
              {visibleTools.map((tool) => <article class:list={["tool-card", { "is-failed": tool.capture_status === "failed" }]} data-tool data-tool-id={tool.id} data-category={tool.category} data-search={toolSearchBlob(tool)}>
                <a class="card-link" href={tool.url} target="_blank" rel="noreferrer" aria-label={tool.name}></a>
                <div class="cover-wrap">
                  {tool.cover ? <img src={`/${tool.cover}`} alt="" loading="lazy" /> : <div class="cover-fallback" aria-hidden="true">{categoryIcon(tool.category)}</div>}
                </div>
                <div class="card-content">
                  <div class="card-meta"><span class="category">{tool.category}</span><span class:list={["status", statusClass(tool.status)]}>{tool.status}</span></div>
                    <h3>{tool.name}</h3>
                    <p title={tool.capture_status === "failed" ? "这条收藏暂时未抓取成功。" : tool.headline || "尚待补充用途说明"}>{tool.capture_status === "failed" ? "这条收藏暂时未抓取成功。" : tool.headline || "尚待补充用途说明"}</p>
                    <p class="ask-reason" data-ask-reason hidden></p>
                  {tool.capture_status === "failed" ? <button type="button" class="retry-button" data-retry>重新同步</button> : <div class="tag-list">{(tool.tags ?? []).slice(0, 8).map((tag) => <span>{tag}</span>)}</div>}
                </div>
              </article>)}
            </div>
          </section>
          </main>
            </div>
          </section>
        </>
      )}
    </div>
    <footer class="site-footer">
      <p><strong>数据来源说明</strong>：部分数据源自 <a href="https://xiaoer-tools-wall.vercel.app/" target="_blank" rel="noreferrer">xiaoer's 私人弹药库</a>，在此致谢并保留原站链接。</p>
    </footer>
    <script type="application/json" id="ask-ai-catalog" set:html={askCatalogJson} />
    <script>
      import { bindWallPage } from "../lib/ask-ai-page.mjs";
      bindWallPage(document);
    </script>
  </body>
</html>
