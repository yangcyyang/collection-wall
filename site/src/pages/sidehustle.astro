---
import "../styles/global.css";
import LogoutControl from "../components/LogoutControl.astro";
import SiteNav from "../components/SiteNav.astro";
import ThemeInit from "../components/ThemeInit.astro";
import SidehustleViewer from "../components/SidehustleViewer.astro";
import { formatBeijingDateTime } from "../lib/news.mjs";
import {
  getIdeasFeed,
  sidehustleKindLabel,
  sidehustleStatusClass,
  sidehustleStatusLabel,
} from "../lib/sidehustle.mjs";

const feed = await getIdeasFeed();
const items = feed.items;
const summary = feed.summary;
const hasContent = items.length > 0;
const hasSummary = summary.top_plays.length + summary.price_bands.length + summary.gaps.length > 0;
const updated = formatBeijingDateTime(feed.updated_at);
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ThemeInit />
    <meta name="description" content={feed.title || "AI 副业机会雷达"} />
    <title>副业 · 工具库</title>
  </head>
  <body>
    <a class="skip-link" href="#sidehustle-list">跳到列表</a>
    <div class="page-shell">
      <header class="site-header">
        <div>
          <p class="eyebrow">副业</p>
          <h1>副业</h1>
          {feed.title && <p class="intro">{feed.title}{updated ? ` · ${updated}` : ""}</p>}
        </div>
        <div class="header-stats">
          <p class="record-count">{items.length} 条机会</p>
          <LogoutControl />
        </div>
      </header>

      <SiteNav current="sidehustle" />

      {!hasContent ? (
        <main id="sidehustle-list">
          <section class="empty-state" aria-labelledby="empty-title">
            <p class="empty-icon">✦</p>
            <h2 id="empty-title">暂时没有副业机会</h2>
            <p>等待 data/sidehustle 写入 ideas.json 后会出现在这里。</p>
          </section>
        </main>
      ) : (
        <main id="sidehustle-list">
          {hasSummary && (
            <section class="tool-section" aria-labelledby="sidehustle-summary-title">
              <div class="section-heading">
                <h2 id="sidehustle-summary-title">机会摘要</h2>
                <p>{items.length} 条</p>
              </div>
              {summary.top_plays.length > 0 && (
                <p class="intro"><strong>热门玩法</strong> · {summary.top_plays.join("、")}</p>
              )}
              {summary.price_bands.length > 0 && (
                <p class="intro"><strong>价格带</strong> · {summary.price_bands.join("、")}</p>
              )}
              {summary.gaps.length > 0 && (
                <p class="intro"><strong>缺口</strong> · {summary.gaps.join("、")}</p>
              )}
            </section>
          )}
          <section class="tool-section" aria-labelledby="sidehustle-items-title">
            <div class="section-heading">
              <h2 id="sidehustle-items-title">机会列表</h2>
              <p>{items.length} 条</p>
            </div>
            <div class="tool-grid">
              {items.map((item) => (
                <article class="tool-card">
                  <button type="button" class="card-link" data-sidehustle-open data-sidehustle-key={item.id} aria-label={item.title}></button>
                  <div class="card-content">
                    <div class="card-meta">
                      <span class="tweet-score">{item.score}</span>
                      {item.kind && <span class="category">{sidehustleKindLabel(item.kind)}</span>}
                      <span class:list={["status", sidehustleStatusClass(item.status)]}>{sidehustleStatusLabel(item.status)}</span>
                    </div>
                    <h3>{item.title}</h3>
                    <p>{item.summary}</p>
                    <div class="tag-list">{(item.tags ?? []).slice(0, 8).map((tag) => <span>{tag}</span>)}</div>
                  </div>
                </article>
              ))}
            </div>
          </section>
        </main>
      )}
    </div>
    <SidehustleViewer items={items} />
    <footer class="site-footer">
      <p>数据来自 data/sidehustle JSON，构建时读取，不另存 HTML。</p>
    </footer>
  </body>
</html>
