---
import "../styles/global.css";
import PromptViewer from "../components/PromptViewer.astro";
import SiteNav from "../components/SiteNav.astro";
import { formatPromptEyebrow, getPromptSets, imageCount } from "../lib/prompts";
import { promptFacetFilters, promptFacets, promptTypeFilters, sourceLinkLabel } from "../lib/prompt-type.mjs";

const sets = await getPromptSets();
const eyebrow = formatPromptEyebrow(sets);
const totalImages = imageCount(sets);
const typeFilters = promptTypeFilters(sets);
const facetFilters = promptFacetFilters(sets);
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="可复制的生图提示词图墙" />
    <title>提示词 · 工具库</title>
  </head>
  <body>
    <a class="skip-link" href="#prompt-masonry">跳到列表</a>
    <div class="page-shell">
      <header class="site-header">
        <div>
          <p class="eyebrow">{eyebrow}</p>
          <h1>提示词</h1>
          <p class="intro">先刷图，点开同时看到大图和完整提示词。可用类型、标签和搜索收窄。</p>
        </div>
        <p class="record-count" data-record-count data-total-sets={sets.length} data-total-images={totalImages}>{sets.length} 套 · {totalImages} 张图</p>
      </header>

      <SiteNav current="prompts" />

      {sets.length === 0 ? (
        <main id="prompt-masonry">
        <section class="empty-state" aria-labelledby="empty-title">
          <p class="empty-icon">✦</p>
          <h2 id="empty-title">还没有提示词</h2>
          <p>把提示词 JSON 放到 data/prompts/ 后会出现在这里。</p>
        </section>
        </main>
      ) : (
        <>
          <div class="prompt-toolbar">
            <label class="prompt-search">
              <span class="visually-hidden">搜索提示词正文</span>
              <input type="search" data-prompt-search placeholder="搜索提示词正文" />
            </label>
          </div>
          <div class="tag-filter-row" aria-label="按图片类型筛选">
            <button class="tag-filter is-selected" type="button" data-type-filter="" aria-pressed="true">全部<em>{sets.length}</em></button>
            {typeFilters.map(({ type, count }) => (
              <button class="tag-filter" type="button" data-type-filter={type} aria-pressed="false">{type}<em>{count}</em></button>
            ))}
          </div>
          {facetFilters.length > 0 && (
            <div class="tag-filter-row" aria-label="按标签筛选，可多选">
              {facetFilters.map(({ facet, count }) => (
                <button class="tag-filter" type="button" data-facet-filter={facet} aria-pressed="false">{facet}<em>{count}</em></button>
              ))}
            </div>
          )}
          <p class="prompt-empty-filter" data-filter-empty hidden>没有符合筛选的套 <button type="button" data-clear-filters>清除筛选</button></p>

          <main id="prompt-masonry" class="prompt-masonry" aria-label="提示词图片墙">
            {sets.map((set) => {
              const facets = promptFacets(set);
              const caption = [set.type, ...facets.slice(0, 2)].filter(Boolean).join(" · ");
              return (
              <article
                class="prompt-card"
                data-prompt-card
                data-item-id={set.id}
                data-source={set.source}
                data-type={set.type}
                data-facets={facets.join(",")}
                data-image-count={set.images.length}
              >
                <button type="button" class="prompt-image-open" data-open-viewer aria-label={`查看「${caption}」大图和提示词`}>
                  <img src={set.images[0]} alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
                  {set.images.length > 1 && <span class="prompt-count-badge">{set.images.length}张</span>}
                </button>
                <p class="prompt-card-caption">{caption}</p>
                <ul class="prompt-set-images" hidden>
                  {set.images.map((url) => <li data-set-image={url}></li>)}
                </ul>
                <a class="prompt-source" hidden href={set.tweetUrl} target="_blank" rel="noreferrer">{sourceLinkLabel(set.tweetUrl)}</a>
                <pre class="prompt-payload" hidden>{set.prompt}</pre>
              </article>
              );
            })}
          </main>
        </>
      )}
    </div>
    <footer class="site-footer">
      <p><strong>数据来源说明</strong>：图片与提示词来自小小东推文、小小东邮件、AI Art Daily 等公开来源，提示词按原文照录。</p>
    </footer>
    <PromptViewer />
    <script>
      const filterEmpty = document.querySelector("[data-filter-empty]");
      const searchInput = document.querySelector("[data-prompt-search]");
      const typeButtons = document.querySelectorAll("[data-type-filter]");
      const facetButtons = document.querySelectorAll("[data-facet-filter]");
      const cards = document.querySelectorAll("[data-prompt-card]");
      const countEl = document.querySelector("[data-record-count]");
      let activeType = "";
      const activeFacets = new Set();

      function refresh() {
        const query = (searchInput?.value ?? "").trim().toLowerCase();
        let visibleSets = 0;
        let visibleImages = 0;
        cards.forEach((card) => {
          const type = card.getAttribute("data-type") ?? "";
          const facets = (card.getAttribute("data-facets") ?? "").split(",").filter(Boolean);
          const prompt = (card.querySelector(".prompt-payload")?.textContent ?? "").toLowerCase();
          const typeOk = !activeType || type === activeType;
          const facetOk = [...activeFacets].every((facet) => facets.includes(facet));
          const searchOk = !query || prompt.includes(query);
          const hide = !(typeOk && facetOk && searchOk);
          card.hidden = hide;
          if (!hide) {
            visibleSets += 1;
            visibleImages += Number(card.getAttribute("data-image-count") ?? 0);
          }
        });
        if (countEl) countEl.textContent = `${visibleSets} 套 · ${visibleImages} 张图`;
        if (filterEmpty) filterEmpty.hidden = visibleSets !== 0;
      }

      typeButtons.forEach((button) => button.addEventListener("click", () => {
        const next = button.getAttribute("data-type-filter") ?? "";
        activeType = activeType === next ? "" : next;
        typeButtons.forEach((item) => {
          const selected = (item.getAttribute("data-type-filter") ?? "") === activeType;
          item.classList.toggle("is-selected", selected);
          item.setAttribute("aria-pressed", selected ? "true" : "false");
        });
        refresh();
      }));

      facetButtons.forEach((button) => button.addEventListener("click", () => {
        const facet = button.getAttribute("data-facet-filter") ?? "";
        if (!facet) return;
        if (activeFacets.has(facet)) activeFacets.delete(facet);
        else activeFacets.add(facet);
        const selected = activeFacets.has(facet);
        button.classList.toggle("is-selected", selected);
        button.setAttribute("aria-pressed", selected ? "true" : "false");
        refresh();
      }));

      searchInput?.addEventListener("input", refresh);
      document.querySelector("[data-clear-filters]")?.addEventListener("click", () => {
        activeType = "";
        activeFacets.clear();
        if (searchInput) searchInput.value = "";
        typeButtons.forEach((item) => {
          const selected = (item.getAttribute("data-type-filter") ?? "") === "";
          item.classList.toggle("is-selected", selected);
          item.setAttribute("aria-pressed", selected ? "true" : "false");
        });
        facetButtons.forEach((item) => {
          item.classList.remove("is-selected");
          item.setAttribute("aria-pressed", "false");
        });
        refresh();
      });
    </script>
  </body>
</html>
