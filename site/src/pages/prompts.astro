---
import "../styles/global.css";
import PromptViewer from "../components/PromptViewer.astro";
import LogoutControl from "../components/LogoutControl.astro";
import SiteNav from "../components/SiteNav.astro";
import {
  encodePromptGalleryIndex,
  formatPromptEyebrow,
  formatPromptGalleryCount,
  getPromptSets,
  imageCount,
  pagePromptSlice,
  PROMPT_PAGE_SIZE,
  toPromptGalleryIndex,
} from "../lib/prompts";
import { promptFacetFilters, promptTypeFilters } from "../lib/prompt-type.mjs";

const sets = await getPromptSets();
const eyebrow = formatPromptEyebrow(sets);
const totalImages = imageCount(sets);
const typeFilters = promptTypeFilters(sets);
const facetFilters = promptFacetFilters(sets);
const indexJson = encodePromptGalleryIndex(toPromptGalleryIndex(sets));
const firstPage = pagePromptSlice(sets.length, 1, PROMPT_PAGE_SIZE);
const countLabel = formatPromptGalleryCount({
  matched: sets.length,
  page: firstPage.page,
  pages: firstPage.pages,
});
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="可复制的生图提示词图墙" />
    <title>提示词 · 工具库</title>
  </head>
  <body>
    <a class="skip-link" href="#prompt-masonry">跳到列表</a>
    <div class="page-shell">
      <header class="site-header">
        <div>
          <p class="eyebrow">{eyebrow}</p>
          <h1>提示词</h1>
          <p class="intro">先刷图，点开同时看到大图和完整提示词。可用类型、标签和搜索收窄。</p>
        </div>
        <div class="header-stats">
          <p class="record-count" data-record-count data-total-sets={sets.length} data-total-images={totalImages}>{countLabel}</p>
          <LogoutControl />
        </div>
      </header>

      <SiteNav current="prompts" />

      {sets.length === 0 ? (
        <main id="prompt-masonry">
        <section class="empty-state" aria-labelledby="empty-title">
          <p class="empty-icon">✦</p>
          <h2 id="empty-title">还没有提示词</h2>
          <p>把提示词 JSON 放到 data/prompts/ 后会出现在这里。</p>
        </section>
        </main>
      ) : (
        <>
          <div class="prompt-toolbar">
            <label class="prompt-search">
              <span class="visually-hidden">搜索提示词正文</span>
              <input type="search" data-prompt-search placeholder="搜索提示词正文" />
            </label>
          </div>
          <div class="tag-filter-row" aria-label="按图片类型筛选">
            <button class="tag-filter is-selected" type="button" data-type-filter="" aria-pressed="true">全部<em>{sets.length}</em></button>
            {typeFilters.map(({ type, count }) => (
              <button class="tag-filter" type="button" data-type-filter={type} aria-pressed="false">{type}<em>{count}</em></button>
            ))}
          </div>
          {facetFilters.length > 0 && (
            <div class="tag-filter-row" aria-label="按标签筛选，可多选">
              {facetFilters.map(({ facet, count }) => (
                <button class="tag-filter" type="button" data-facet-filter={facet} aria-pressed="false">{facet}<em>{count}</em></button>
              ))}
            </div>
          )}
          <p class="prompt-empty-filter" data-filter-empty hidden>没有符合筛选的套 <button type="button" data-clear-filters>清除筛选</button></p>

          <main
            id="prompt-masonry"
            class="prompt-masonry"
            aria-label="提示词图片墙"
            data-prompt-mount
            data-page-size={PROMPT_PAGE_SIZE}
          ></main>
          <nav class="pager" hidden data-prompt-pager aria-label="分页导航">
            <button class="pager-btn" type="button" data-pager-prev>← 上一页</button>
            <span class="pager-status" data-pager-status></span>
            <button class="pager-btn" type="button" data-pager-next>下一页 →</button>
          </nav>
          <script type="application/json" data-prompt-index is:inline set:html={indexJson}></script>
        </>
      )}
    </div>
    <footer class="site-footer">
      <p><strong>数据来源说明</strong>：图片与提示词来自小小东推文、小小东邮件、AI Art Daily 等公开来源，提示词按原文照录。</p>
    </footer>
    <PromptViewer />
    <script>
      import { initPromptGallery } from "../lib/prompt-gallery-page.mjs";
      initPromptGallery(document);
    </script>
  </body>
</html>
