---
import "../styles/global.css";
import PromptViewer from "../components/PromptViewer.astro";
import SiteNav from "../components/SiteNav.astro";
import { formatPromptEyebrow, getPromptSets, imageCount } from "../lib/prompts";
import { promptTypeFilters, sourceLinkLabel } from "../lib/prompt-type.mjs";

const sets = await getPromptSets();
const eyebrow = formatPromptEyebrow(sets);
const totalImages = imageCount(sets);
const typeFilters = promptTypeFilters(sets);
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="可复制的生图提示词瀑布流" />
    <title>提示词 · 工具库</title>
  </head>
  <body>
    <a class="skip-link" href="#prompt-masonry">跳到列表</a>
    <div class="page-shell">
      <header class="site-header">
        <div>
          <p class="eyebrow">{eyebrow}</p>
          <h1>提示词</h1>
          <p class="intro">每张卡片是一套提示词。点封面查看组内大图，底部按钮复制提示词，「原推 / 原文」打开来源。</p>
        </div>
        <p class="record-count" data-record-count data-total-sets={sets.length} data-total-images={totalImages}>{sets.length} 套 · {totalImages} 张图</p>
      </header>

      <SiteNav current="prompts" />

      {sets.length === 0 ? (
        <main id="prompt-masonry">
        <section class="empty-state" aria-labelledby="empty-title">
          <p class="empty-icon">✦</p>
          <h2 id="empty-title">还没有提示词</h2>
          <p>把提示词 JSON 放到 data/prompts/ 后会出现在这里。</p>
        </section>
        </main>
      ) : (
        <>
          <div class="tag-filter-row" aria-label="按图片类型筛选">
            <button class="tag-filter is-selected" type="button" data-tag-filter="" aria-pressed="true">全部<em>{sets.length}</em></button>
            {typeFilters.map(({ type, count }) => (
              <button class="tag-filter" type="button" data-tag-filter={type} aria-pressed="false">{type}<em>{count}</em></button>
            ))}
          </div>

          <main id="prompt-masonry" class="prompt-masonry" aria-label="提示词图片墙">
            {sets.map((set) => (
              <article
                class="prompt-card"
                data-prompt-card
                data-item-id={set.id}
                data-source={set.source}
                data-tags={set.type}
                data-image-count={set.images.length}
              >
                <button type="button" class="prompt-image-open" data-open-viewer aria-label="查看同组大图">
                  <img src={set.images[0]} alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
                  {set.images.length > 1 && <span class="prompt-count-badge">{set.images.length}张</span>}
                </button>
                <ul class="prompt-set-images" hidden>
                  {set.images.map((url) => <li data-set-image={url}></li>)}
                </ul>
                <div class="prompt-card-bar">
                  <a class="prompt-source" href={set.tweetUrl} target="_blank" rel="noreferrer">{sourceLinkLabel(set.tweetUrl)}</a>
                  <button type="button" class="prompt-copy" data-copy-prompt>
                    <span data-copy-label>复制提示词</span>
                  </button>
                </div>
                <pre class="prompt-payload" hidden>{set.prompt}</pre>
              </article>
            ))}
          </main>
        </>
      )}
    </div>
    <footer class="site-footer">
      <p><strong>数据来源说明</strong>：图片与提示词来自小小东推文、小小东邮件、AI Art Daily 等公开来源，提示词按原文照录。</p>
    </footer>
    <PromptViewer />
    <script>
      const copiedLabel = "已复制";
      const idleLabel = "复制提示词";
      const filterButtons = document.querySelectorAll("[data-tag-filter]");
      const cards = document.querySelectorAll("[data-prompt-card]");
      const countEl = document.querySelector("[data-record-count]");
      let activeTag = "";

      function refresh() {
        let visibleSets = 0;
        let visibleImages = 0;
        cards.forEach((card) => {
          const tags = (card.getAttribute("data-tags") ?? "").split(",");
          const hide = Boolean(activeTag) && !tags.includes(activeTag);
          card.hidden = hide;
          if (!hide) {
            visibleSets += 1;
            visibleImages += Number(card.getAttribute("data-image-count") ?? 0);
          }
        });
        if (countEl) {
          countEl.textContent = `${visibleSets} 套 · ${visibleImages} 张图`;
        }
      }

      filterButtons.forEach((button) => button.addEventListener("click", () => {
        const nextTag = button.getAttribute("data-tag-filter") ?? "";
        activeTag = activeTag === nextTag ? "" : nextTag;
        filterButtons.forEach((item) => {
          const selected = (item.getAttribute("data-tag-filter") ?? "") === activeTag;
          item.classList.toggle("is-selected", selected);
          item.setAttribute("aria-pressed", selected ? "true" : "false");
        });
        refresh();
      }));

      async function writeClipboard(text) {
        if (navigator.clipboard?.writeText) {
          await navigator.clipboard.writeText(text);
          return;
        }
        const area = document.createElement("textarea");
        area.value = text;
        area.setAttribute("readonly", "");
        area.style.position = "fixed";
        area.style.left = "-9999px";
        document.body.append(area);
        area.select();
        document.execCommand("copy");
        area.remove();
      }

      document.querySelectorAll("[data-copy-prompt]").forEach((button) => {
        button.addEventListener("click", async () => {
          const card = button.closest("[data-prompt-card]");
          const payload = card?.querySelector(".prompt-payload");
          const text = payload?.textContent ?? "";
          const label = button.querySelector("[data-copy-label]");
          try {
            await writeClipboard(text);
            button.classList.add("is-copied");
            if (label) label.textContent = copiedLabel;
            window.setTimeout(() => {
              button.classList.remove("is-copied");
              if (label) label.textContent = idleLabel;
            }, 1600);
          } catch {
            if (label) label.textContent = "无法复制，请选中提示词手动复制";
            if (payload) {
              payload.hidden = false;
              payload.setAttribute("tabindex", "0");
              payload.focus();
            }
          }
        });
      });
    </script>
  </body>
</html>
