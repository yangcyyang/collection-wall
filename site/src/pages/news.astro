---
import "../styles/global.css";
import NewsDayGroup from "../components/NewsDayGroup.astro";
import SiteNav from "../components/SiteNav.astro";
import { categoryFilters, getNewsFeed, groupNewsDays } from "../lib/news.mjs";

const feed = await getNewsFeed();
const items = feed.items ?? [];
const days = groupNewsDays(items);
const filters = categoryFilters(items);
const aihotHome = "https://aihot.virxact.com/";
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="按北京时间日历日排列的 AIHOT 精选时间线" />
    <title>资讯 · 工具库</title>
  </head>
  <body>
    <a class="skip-link" href="#news-list">跳到列表</a>
    <div class="page-shell">
      <header class="site-header">
        <div>
          <p class="eyebrow">AI 资讯精选</p>
          <h1>资讯</h1>
          <p class="intro">
            累积收录的 AIHOT 精选，按北京时间日历日排成时间线，最新一天默认展开。摘要与推荐理由照录原文。
            数据来源 <a href={aihotHome} target="_blank" rel="noreferrer">AIHOT</a>。
          </p>
        </div>
        <p class="record-count">{items.length} 条已收录</p>
      </header>

      <SiteNav current="news" />

      {days.length === 0 ? (
        <main id="news-list">
          <section class="empty-state" aria-labelledby="empty-title">
            <p class="empty-icon">✦</p>
            <h2 id="empty-title">暂时没有资讯</h2>
            <p>{feed.error || "AIHOT 精选尚未写入 data/news/aihot.json。"}</p>
            <p>数据来源 <a href={aihotHome} target="_blank" rel="noreferrer">AIHOT</a>。</p>
          </section>
        </main>
      ) : (
        <>
          {filters.length > 0 && (
            <div class="tag-filter-row" aria-label="按分类筛选">
              <button class="tag-filter is-selected" type="button" data-tag-filter="" aria-pressed="true">全部<em>{items.length}</em></button>
              {filters.map(({ category, label, count }) => (
                <button class="tag-filter" type="button" data-tag-filter={category} aria-pressed="false">{label}<em>{count}</em></button>
              ))}
            </div>
          )}
          {feed.daily?.url && (
            <p class="news-daily">
              最新日报 {feed.daily.date}
              {feed.daily.title ? ` · ${feed.daily.title}` : ""}
              {" · "}
              <a href={feed.daily.url} target="_blank" rel="noreferrer">在 AIHOT 阅读 →</a>
            </p>
          )}
          <main id="news-list" class="twitter-timeline news-timeline" aria-label="AIHOT 精选资讯">
            {days.map((day, index) => <NewsDayGroup day={day} defaultOpen={index === 0} />)}
          </main>
        </>
      )}
    </div>
    <footer class="site-footer">
      <p>
        数据来源 <a href={aihotHome} target="_blank" rel="noreferrer">AIHOT</a>
        。精选公开 API 累积收藏，供个人非商业使用。摘要与推荐理由未改写。
      </p>
    </footer>
    <script>
      const filterButtons = document.querySelectorAll("[data-tag-filter]");
      const cards = document.querySelectorAll("[data-news-card]");
      const dayGroups = document.querySelectorAll("[data-day]");
      let activeTag = "";

      function refresh() {
        cards.forEach((card) => {
          const tags = (card.getAttribute("data-tags") ?? "").split(",");
          card.hidden = Boolean(activeTag) && !tags.includes(activeTag);
        });
        dayGroups.forEach((group) => {
          group.hidden = !group.querySelector("[data-news-card]:not([hidden])");
        });
      }

      const autoOpened = new Set();
      function syncAutoExpand() {
        autoOpened.forEach((el) => { el.open = false; });
        autoOpened.clear();
        if (!activeTag) return;
        dayGroups.forEach((el) => {
          if (el.hidden || el.open) return;
          if (!el.querySelector("[data-news-card]:not([hidden])")) return;
          el.open = true;
          autoOpened.add(el);
        });
      }

      filterButtons.forEach((button) => button.addEventListener("click", () => {
        const nextTag = button.getAttribute("data-tag-filter") ?? "";
        activeTag = activeTag === nextTag ? "" : nextTag;
        filterButtons.forEach((item) => {
          const selected = (item.getAttribute("data-tag-filter") ?? "") === activeTag;
          item.classList.toggle("is-selected", selected);
          item.setAttribute("aria-pressed", selected ? "true" : "false");
        });
        refresh();
        syncAutoExpand();
      }));
    </script>
  </body>
</html>
