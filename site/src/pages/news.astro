---
import "../styles/global.css";
import SiteNav from "../components/SiteNav.astro";
import {
  categoryFilters,
  categoryLabel,
  formatBeijingDateTime,
  getNewsFeed,
} from "../lib/news.mjs";

const feed = await getNewsFeed();
const items = feed.items ?? [];
const filters = categoryFilters(items);
const aihotHome = "https://aihot.virxact.com/";
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="从 AIHOT 精选的近 24 小时 AI 资讯" />
    <title>资讯 · 工具库</title>
  </head>
  <body>
    <a class="skip-link" href="#news-list">跳到列表</a>
    <div class="page-shell">
      <header class="site-header">
        <div>
          <p class="eyebrow">AI 资讯精选</p>
          <h1>资讯</h1>
          <p class="intro">
            近 24 小时 AIHOT 精选，标题链到 AIHOT 条目页，摘要与推荐理由照录原文。
            数据来源 <a href={aihotHome} target="_blank" rel="noreferrer">AIHOT</a>。
          </p>
        </div>
        <p class="record-count">{items.length} 条已收录</p>
      </header>

      <SiteNav current="news" />

      {items.length === 0 ? (
        <main id="news-list">
          <section class="empty-state" aria-labelledby="empty-title">
            <p class="empty-icon">✦</p>
            <h2 id="empty-title">暂时没有资讯</h2>
            <p>{feed.error || "AIHOT 精选尚未写入 data/news/aihot.json。"}</p>
            <p>数据来源 <a href={aihotHome} target="_blank" rel="noreferrer">AIHOT</a>。</p>
          </section>
        </main>
      ) : (
        <>
          {filters.length > 0 && (
            <div class="tag-filter-row" aria-label="按分类筛选">
              <button class="tag-filter is-selected" type="button" data-tag-filter="" aria-pressed="true">全部<em>{items.length}</em></button>
              {filters.map(({ category, label, count }) => (
                <button class="tag-filter" type="button" data-tag-filter={category} aria-pressed="false">{label}<em>{count}</em></button>
              ))}
            </div>
          )}
          {feed.daily?.url && (
            <p class="news-daily">
              最新日报 {feed.daily.date}
              {feed.daily.title ? ` · ${feed.daily.title}` : ""}
              {" · "}
              <a href={feed.daily.url} target="_blank" rel="noreferrer">在 AIHOT 阅读 →</a>
            </p>
          )}
          <main id="news-list" class="news-list" aria-label="AIHOT 精选资讯">
            {items.map((item) => (
              <article class="tweet-card news-card" data-news-card data-tags={item.category}>
                <div class="tweet-body">
                  <div class="tweet-meta">
                    {item.category && <span class="category">{categoryLabel(item.category)}</span>}
                    {item.source && <span>{item.source}</span>}
                    <time datetime={item.published_at || item.discovered_at}>
                      {formatBeijingDateTime(item.published_at || item.discovered_at)}
                    </time>
                  </div>
                  <h3 class="tweet-title">
                    {item.links.aihot ? (
                      <a href={item.links.aihot} target="_blank" rel="noreferrer">{item.title}</a>
                    ) : item.title}
                  </h3>
                  {item.summary && <p class="tweet-summary">{item.summary}</p>}
                  {item.reason && <p class="tweet-reason">推荐理由：{item.reason}</p>}
                  {item.links.original && (
                    <p class="news-original">
                      <a class="tweet-link" href={item.links.original} target="_blank" rel="noreferrer">原文 →</a>
                    </p>
                  )}
                </div>
              </article>
            ))}
          </main>
        </>
      )}
    </div>
    <footer class="site-footer">
      <p>
        <strong>数据来源说明</strong>：条目来自
        <a href={aihotHome} target="_blank" rel="noreferrer">AIHOT</a>
        近 24 小时精选公开 API，供个人非商业收藏。摘要与推荐理由未改写。
      </p>
    </footer>
    <script>
      const filterButtons = document.querySelectorAll("[data-tag-filter]");
      const cards = document.querySelectorAll("[data-news-card]");
      let activeTag = "";

      function refresh() {
        cards.forEach((card) => {
          const tags = (card.getAttribute("data-tags") ?? "").split(",");
          card.hidden = Boolean(activeTag) && !tags.includes(activeTag);
        });
      }

      filterButtons.forEach((button) => button.addEventListener("click", () => {
        const nextTag = button.getAttribute("data-tag-filter") ?? "";
        activeTag = activeTag === nextTag ? "" : nextTag;
        filterButtons.forEach((item) => {
          const selected = (item.getAttribute("data-tag-filter") ?? "") === activeTag;
          item.classList.toggle("is-selected", selected);
          item.setAttribute("aria-pressed", selected ? "true" : "false");
        });
        refresh();
      }));
    </script>
  </body>
</html>
