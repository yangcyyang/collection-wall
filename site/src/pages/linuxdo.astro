---
import "../styles/global.css";
import LogoutControl from "../components/LogoutControl.astro";
import SiteNav from "../components/SiteNav.astro";
import { formatBeijingDateTime } from "../lib/news.mjs";
import {
  getDigestFeed,
  getRecentReportDates,
  hasDigestContent,
  linuxdoLikesLabel,
  linuxdoViewsLabel,
} from "../lib/linuxdo.mjs";

const feed = await getDigestFeed();
const hasContent = hasDigestContent(feed);
const updated = formatBeijingDateTime(feed.updated_at);
const recentDates = await getRecentReportDates();
const sections = [
  { key: "hot", title: "今日热门", items: feed.hot, modifier: "is-hot" },
  { key: "share", title: "值得看的分享", items: feed.share, modifier: "is-share" },
];
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={feed.title || "linux.do 热门前沿分享"} />
    <title>linux.do · 工具库</title>
  </head>
  <body>
    <a class="skip-link" href="#linuxdo-list">跳到列表</a>
    <div class="page-shell">
      <header class="site-header">
        <div>
          <p class="eyebrow">linux.do</p>
          <h1>linux.do</h1>
          {feed.title && (
            <p class="intro">
              {feed.title}
              {feed.date ? ` · ${feed.date}` : ""}
              {updated ? ` · ${updated}` : ""}
            </p>
          )}
          {recentDates.length > 0 && (
            <p class="intro history-dates">历史报告 · {recentDates.join(" · ")}（主视图始终读取 digest.json）</p>
          )}
        </div>
        <div class="header-stats">
          <p class="record-count">{feed.count} 条</p>
          <LogoutControl />
        </div>
      </header>

      <SiteNav current="linuxdo" />

      {!hasContent ? (
        <main id="linuxdo-list">
          <section class="empty-state" aria-labelledby="empty-title">
            <p class="empty-icon">✦</p>
            <h2 id="empty-title">暂时没有 linux.do 前沿分享</h2>
            <p>等待 data/linuxdo 写入 digest.json 后会出现在这里。</p>
          </section>
        </main>
      ) : (
        <main
          id="linuxdo-list"
          data-linuxdo-root
          data-linuxdo-date={feed.date}
          data-linuxdo-dismiss-prefix="linuxdo-frontier-dismissed"
        >
          <div class="linuxdo-toolbar tag-filter-row" data-linuxdo-toolbar aria-label="工作台操作">
            <button class="tag-filter" type="button" data-linuxdo-select-all>全选</button>
            <button class="tag-filter" type="button" data-linuxdo-select-none>取消</button>
            <button class="linuxdo-remove" type="button" data-linuxdo-remove disabled>移除所选</button>
            <button class="tag-filter" type="button" data-linuxdo-restore disabled>恢复已移除</button>
            <p class="linuxdo-hidden" data-linuxdo-hidden-count>已隐藏 0 条</p>
          </div>
          {sections.map((section) => (
            <section
              class:list={["tool-section", section.modifier]}
              data-linuxdo-section={section.key}
              aria-labelledby={`linuxdo-${section.key}-title`}
            >
              <div class="section-heading">
                <h2 id={`linuxdo-${section.key}-title`}>{section.title}</h2>
                <p data-linuxdo-section-count>{section.items.length} 条</p>
              </div>
              {section.items.length === 0 ? (
                <p class="section-empty">暂时没有{section.title}</p>
              ) : (
                <>
                  <p class="section-empty" data-linuxdo-section-empty hidden>本节条目已全部隐藏</p>
                  <div class="tool-grid">
                    {section.items.map((item) => {
                      const likes = linuxdoLikesLabel(item.likes);
                      const views = linuxdoViewsLabel(item.views);
                      return (
                        <article class="tool-card" data-linuxdo-card data-linuxdo-id={item.id} data-linuxdo-group={item.group}>
                          <div class="card-content">
                            <div class="card-meta linuxdo-card-meta">
                              <label class="linuxdo-check">
                                <input type="checkbox" data-linuxdo-check value={item.id} />
                                <span class="visually-hidden">选择 {item.title}</span>
                              </label>
                              {likes && <span class="category">{likes}</span>}
                              {views && <span class="category">{views}</span>}
                            </div>
                            <h3>
                              {item.url ? (
                                <a href={item.url} target="_blank" rel="noreferrer">{item.title}</a>
                              ) : item.title}
                            </h3>
                            {item.why && <p>{item.why}</p>}
                          </div>
                        </article>
                      );
                    })}
                  </div>
                </>
              )}
            </section>
          ))}
        </main>
      )}
    </div>
    <footer class="site-footer">
      <p>数据来自 data/linuxdo JSON，构建时读取，不另存 HTML。移除记录只留在本机浏览器。</p>
    </footer>
    <script>
      import { bindLinuxdoWorkbench } from "../lib/linuxdo-dismiss.mjs";

      const root = document.querySelector("[data-linuxdo-root]");
      if (root instanceof HTMLElement) bindLinuxdoWorkbench(root);
    </script>
  </body>
</html>

<style>
  .linuxdo-toolbar { align-items: center; }
  .linuxdo-remove {
    background: var(--color-badge-new);
    border: 0;
    border-radius: var(--radius-card);
    color: var(--color-surface);
    font-size: var(--font-size-caption);
    padding: var(--spacing-xs) var(--spacing-md);
  }
  .linuxdo-remove:disabled,
  .tag-filter:disabled { cursor: not-allowed; opacity: 0.45; }
  .linuxdo-remove:focus-visible { outline: var(--outline-width) solid var(--color-badge-new); outline-offset: var(--outline-width); }
  .linuxdo-card-meta { justify-content: flex-start; gap: var(--spacing-sm); }
  .linuxdo-hidden { color: var(--color-text-secondary); font-size: var(--font-size-caption); margin: 0; }
  .linuxdo-check { align-items: center; display: inline-flex; position: relative; z-index: 2; }
  .tool-section.is-hot,
  .tool-section.is-share {
    border-radius: var(--radius-card);
    margin: var(--spacing-md) 0;
    padding-left: var(--spacing-md);
    padding-right: var(--spacing-md);
  }
  .tool-section.is-hot {
    background: color-mix(in srgb, var(--color-badge-new) 10%, var(--color-surface));
    border-left: 4px solid var(--color-badge-new);
  }
  .tool-section.is-share {
    background: color-mix(in srgb, var(--color-badge-frequent) 10%, var(--color-surface));
    border-left: 4px solid var(--color-badge-frequent);
  }
  .section-empty {
    color: var(--color-text-secondary);
    font-size: var(--font-size-caption);
    margin: 0 0 var(--spacing-md);
  }
  .tool-card h3 a { color: var(--color-brand); text-decoration: none; }
  .tool-card h3 a:hover { text-decoration: underline; }
  .history-dates { font-size: var(--font-size-caption); }
</style>
