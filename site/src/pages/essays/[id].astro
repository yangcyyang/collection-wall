---
import "../../styles/global.css";
import LogoutControl from "../../components/LogoutControl.astro";
import SiteNav from "../../components/SiteNav.astro";
import { getEssay, getEssaysFeed } from "../../lib/essays";

export async function getStaticPaths() {
  const feed = await getEssaysFeed();
  return feed.items.map((item) => ({ params: { id: item.id } }));
}

const essay = await getEssay(Astro.params.id);
if (!essay) {
  throw new Error(`文章不存在：${Astro.params.id}`);
}

const originalUrl = essay.article_url || essay.source_url;
const hostsMedia = /<(?:img|video)\b/.test(essay.html || "");
const kindNote = essay.kind === "original"
  ? "这是我自己写的文章。"
  : essay.kind === "curated"
    ? (hostsMedia
      ? "这是精选收录的中文原文。"
      : "这是精选收录的中文原文。文中提到的图在原文页面。")
    : (hostsMedia
      ? "这是中文译文。文中的封面和演示视频嵌在正文里。"
      : "这是中文译文。文中提到的图在原文页面。");
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={essay.summary || essay.title} />
    <title>{essay.title} · 文章</title>
  </head>
  <body>
    <a class="skip-link" href="#essay-body">跳到正文</a>
    <div class="page-shell">
      <header class="site-header">
        <div>
          <p class="eyebrow">{essay.kind_label}</p>
          <h1>{essay.title}</h1>
          {essay.title_en && <p class="intro">{essay.title_en}</p>}
          <p class="essay-meta">
            {essay.author_handle ? (
              <a href={`https://x.com/${essay.author_handle}`} rel="noopener noreferrer">{essay.author || `@${essay.author_handle}`}</a>
            ) : (
              essay.author || "未署名"
            )}
            {essay.published_at && <time datetime={essay.published_at}>{essay.published_at}</time>}
            {essay.capture_status === "partial" && <span class="status occasional">正文未收全</span>}
          </p>
          <p class="essay-meta essay-source-links">
            {essay.article_url && essay.source_url && <a href={essay.source_url} rel="noopener noreferrer">原帖</a>}
            {essay.article_url && <a href={essay.article_url} rel="noopener noreferrer">原文长文</a>}
            {!essay.article_url && essay.source_url && <a href={essay.source_url} rel="noopener noreferrer">原文</a>}
            {essay.blog_url && <a href={essay.blog_url} rel="noopener noreferrer">互动版</a>}
          </p>
        </div>
        <div class="header-stats">
          <a class="essay-back" href="/essays/">返回文章列表</a>
          <LogoutControl />
        </div>
      </header>

      <SiteNav current="essays" />

      <main id="essay-body">
        {essay.capture_status === "partial" && (
          <p class="essay-partial">这篇正文还不完整，下面是现有内容。原文仍可打开。</p>
        )}
        {essay.html ? (
          <article class="essay-prose" set:html={essay.html} />
        ) : (
          <section class="empty-state" aria-labelledby="missing-body">
            <h2 id="missing-body">正文还没写入</h2>
            <p>{essay.summary || "markdown 文件缺失。"}</p>
            {originalUrl && <p><a href={originalUrl} rel="noopener noreferrer">打开原文</a></p>}
          </section>
        )}
      </main>
    </div>
    <footer class="site-footer">
      <p>
        <strong>说明</strong>：{kindNote}
        {originalUrl && <>原文：<a href={originalUrl} rel="noopener noreferrer">{originalUrl}</a></>}
      </p>
    </footer>
  </body>
</html>
