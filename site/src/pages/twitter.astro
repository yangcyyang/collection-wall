---
import "../styles/global.css";
import { getTwitterDays, splitRecentAndArchive, tagCounts } from "../lib/twitter";
import TwitterDayGroup from "../components/TwitterDayGroup.astro";

const days = await getTwitterDays();
const { recent, archive } = splitRecentAndArchive(days);
const tags = tagCounts(days);
const totalItems = days.reduce((sum, day) => sum + day.items.length, 0);
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="cy 关注流每日精选 30 条" />
    <title>推特日报 · 工具库</title>
  </head>
  <body>
    <main class="page-shell">
      <header class="site-header">
        <div>
          <p class="eyebrow">Following 时间线精选</p>
          <h1>推特日报</h1>
          <p class="intro">每天中午从关注流里挑出最值得看的 30 条，按时间倒序排列。</p>
        </div>
        <p class="record-count">{totalItems} 条已收录</p>
      </header>

      <nav class="tabs" aria-label="站点栏目">
        <a class="tab" href="/">收藏墙</a>
        <a class="tab is-active" href="/twitter/">推特日报</a>
        <span class="tab is-disabled">每日日报 · 即将开放</span>
        <span class="tab is-disabled">知识总结 · 即将开放</span>
      </nav>

      {days.length === 0 ? (
        <section class="empty-state" aria-labelledby="empty-title">
          <p class="empty-icon">✦</p>
          <h2 id="empty-title">还没有日报</h2>
          <p>等待第一次采集任务写入 data/twitter/ 后会出现在这里。</p>
        </section>
      ) : (
        <>
          {tags.length > 0 && (
            <div class="tag-filter-row" aria-label="按标签筛选">
              <button class="tag-filter is-selected" type="button" data-tag-filter="">全部</button>
              {tags.map(({ tag, count }) => <button class="tag-filter" type="button" data-tag-filter={tag}>{tag}<em>{count}</em></button>)}
            </div>
          )}

          <section class="twitter-timeline" aria-label="最近日报">
            {recent.map((day) => <TwitterDayGroup day={day} />)}
          </section>

          {archive.length > 0 && (
            <details class="archive-section">
              <summary>更早归档（{archive.length} 天）</summary>
              <section class="twitter-timeline">
                {archive.map((day) => <TwitterDayGroup day={day} />)}
              </section>
            </details>
          )}
        </>
      )}
    </main>
    <footer class="site-footer">
      <p><strong>数据来源说明</strong>：内容来自 cy 的 X（Twitter）Following 时间线，AI 按相关度/信息增量/互动热度筛选，去转发去广告。</p>
    </footer>
    <script>
      const filterButtons = document.querySelectorAll("[data-tag-filter]");
      const cards = document.querySelectorAll("[data-tweet]");
      const dayGroups = document.querySelectorAll("[data-day]");
      let activeTag = "";

      function refresh() {
        cards.forEach((card) => {
          const tags = (card.getAttribute("data-tags") ?? "").split(",");
          card.hidden = Boolean(activeTag) && !tags.includes(activeTag);
        });
        dayGroups.forEach((group) => {
          group.hidden = !group.querySelector("[data-tweet]:not([hidden])");
        });
      }

      filterButtons.forEach((button) => button.addEventListener("click", () => {
        const nextTag = button.getAttribute("data-tag-filter") ?? "";
        activeTag = activeTag === nextTag ? "" : nextTag;
        filterButtons.forEach((item) => item.classList.toggle("is-selected", item === button && activeTag !== ""));
        if (!activeTag) filterButtons[0]?.classList.add("is-selected");
        refresh();
      }));

      function openTweet(card) {
        const url = card.getAttribute("data-tweet-url");
        if (url) window.open(url, "_blank", "noopener,noreferrer");
      }

      cards.forEach((card) => {
        card.addEventListener("click", (event) => {
          if (event.target.closest("a, .tag-list")) return;
          openTweet(card);
        });
        card.addEventListener("keydown", (event) => {
          if (event.target !== card) return;
          if (event.key === "Enter" || event.key === " ") {
            event.preventDefault();
            openTweet(card);
          }
        });
      });
    </script>
  </body>
</html>
