# F001 pipeline 本地配置。cp .env.example .env 然后填值，.env 不进 git。

# 必需：AI 分析后端（AI_* 优先；不配则回退 DEEPSEEK_*）
# 2026-07-18 起默认 kimi-for-coding（DeepSeek 余额耗尽后的替代）
AI_API_KEY=<YOUR_AI_API_KEY>
AI_BASE_URL=https://api.kimi.com/coding/v1
AI_MODEL=kimi-for-coding
AI_TEMPERATURE=1  # kimi-for-coding 只允许 1；DeepSeek 建议 0.3

# 回退：DeepSeek API key，https://platform.deepseek.com/usage
DEEPSEEK_API_KEY=<YOUR_DEEPSEEK_API_KEY>
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 可选：本地截图存档目录（不是网站用的 cover，只是本地留一份原图）
# SCREENSHOT_DIR=~/Pictures/bookmark-captures

# 首次人工 push 并配置 upstream 后再改为 1。
# 成功采集会按固定时间窗合并，只提交 data/tools/，再触发 Pages 构建。
AUTO_GIT_SYNC=0
AUTO_GIT_SYNC_INTERVAL_SECONDS=300
